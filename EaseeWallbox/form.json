{
    "elements": [
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Instanz aktiv"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Easee-Konto",
            "expanded": true,
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "Username",
                    "caption": "Benutzername (E-Mail oder Telefonnummer)",
                    "width": "400px"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "Password",
                    "caption": "Passwort",
                    "width": "400px"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "ChargerID",
                    "caption": "Charger-ID (leer = erster Charger im Konto)",
                    "width": "400px"
                },
                {
                    "type": "NumberSpinner",
                    "name": "UpdateInterval",
                    "caption": "Abrufintervall",
                    "suffix": "Minuten",
                    "minimum": 1,
                    "maximum": 60
                },
                {
                    "type": "Select",
                    "name": "MaxPowerKW",
                    "caption": "Maximale Ladeleistung",
                    "options": [
                        {
                            "caption": "11 kW",
                            "value": 11
                        },
                        {
                            "caption": "22 kW",
                            "value": 22
                        },
                        {
                            "caption": "7,4 kW",
                            "value": 7
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Benachrichtigungen",
            "items": [
                {
                    "type": "SelectInstance",
                    "name": "NotifyInstance",
                    "caption": "Visualisierung für Push (Kachel-Visualisierung oder WebFront)",
                    "width": "400px"
                },
                {
                    "type": "CheckBox",
                    "name": "NotifyStart",
                    "caption": "Bei Ladebeginn"
                },
                {
                    "type": "CheckBox",
                    "name": "NotifyEnd",
                    "caption": "Bei Ladeende (mit kWh und Kosten)"
                },
                {
                    "type": "CheckBox",
                    "name": "NotifyError",
                    "caption": "Bei Fehlern der Wallbox oder der API"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Zeitsteuerung",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "EnableSchedule",
                    "caption": "Zeitsteuerung aktivieren (legt die Variablen dafür an)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "ScheduleBuffer",
                    "caption": "Sicherheitspuffer bei „Fertig bis“",
                    "suffix": "Minuten",
                    "minimum": 0,
                    "maximum": 240
                },
                {
                    "type": "Label",
                    "caption": "Modus, Zeiten und Ziel-Energie werden über die Variablen bzw. die Kachel eingestellt. Manuelles Schalten von „Laden“ übersteuert die Zeitsteuerung bis zum Abstecken."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Fahrzeug",
            "items": [
                {
                    "type": "Select",
                    "name": "VehicleMode",
                    "caption": "An der Wallbox lädt",
                    "onChange": "IPS_RequestAction($id, 'FormVehicleMode', $VehicleMode);",
                    "options": [
                        {
                            "caption": "Eigenes Auto",
                            "value": 0
                        },
                        {
                            "caption": "Gastladung (fremde Fahrzeuge)",
                            "value": 1
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "EnableSoc",
                    "caption": "Akkustand des Fahrzeugs anzeigen"
                },
                {
                    "type": "SelectVariable",
                    "name": "SocVariable",
                    "caption": "Variable mit dem Akkustand (0–100 %)",
                    "width": "400px"
                },
                {
                    "type": "NumberSpinner",
                    "name": "BatteryCapacity",
                    "caption": "Nutzbare Akkugröße",
                    "suffix": "kWh",
                    "digits": 1,
                    "minimum": 1,
                    "maximum": 200
                },
                {
                    "type": "Label",
                    "caption": "Die Wallbox kennt den Akkustand nicht – er muss aus einer anderen Quelle kommen (z. B. Hersteller-Cloud des Autos). Die Akkugröße wird nur für „Fertig bis“ mit Ziel in Prozent benötigt.",
                    "name": "SocHint"
                },
                {
                    "type": "Label",
                    "name": "GuestHint",
                    "caption": "Gastladung: Es wird kein Akkustand und kein eigenes Fahrzeugbild angezeigt, „Fertig bis“ arbeitet nur mit dem kWh-Ziel. Die Einstellung gilt dauerhaft, auch nach dem Abstecken, bis sie hier wieder auf „Eigenes Auto“ gestellt wird. Energie und Kosten werden weiter gezählt."
                }
            ],
            "expanded": true
        },
        {
            "type": "ExpansionPanel",
            "caption": "Strompreis, Dashboard & Archiv",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "EnergyPrice",
                    "caption": "Strompreis",
                    "suffix": "€/kWh",
                    "digits": 4,
                    "minimum": 0,
                    "maximum": 2
                },
                {
                    "type": "Label",
                    "caption": "Ein neuer Preis gilt ab dem Übernehmen. Bereits erfasste Tages-, Monats- und Jahreskosten bleiben unverändert."
                },
                {
                    "type": "CheckBox",
                    "name": "Dashboard",
                    "caption": "HTML-Dashboard-Variable anlegen"
                },
                {
                    "type": "CheckBox",
                    "name": "LogPower",
                    "caption": "Ladeleistung automatisch archivieren (für das 24-h-Diagramm)"
                },
                {
                    "type": "CheckBox",
                    "name": "LogEnergy",
                    "caption": "Energie und Kosten als Zähler archivieren (Verbrauch pro Tag/Woche/Monat/Jahr)"
                }
            ],
            "expanded": true
        },
        {
            "type": "ExpansionPanel",
            "caption": "Kachel",
            "items": [
                {
                    "type": "Select",
                    "name": "TileTheme",
                    "caption": "Farbschema der Kachel",
                    "options": [
                        {
                            "caption": "Symcon-Design (Farben der Visualisierung)",
                            "value": 0
                        },
                        {
                            "caption": "Dunkel",
                            "value": 1
                        },
                        {
                            "caption": "Hell",
                            "value": 2
                        }
                    ]
                },
                {
                    "type": "SelectFile",
                    "name": "TileBackground",
                    "caption": "Hintergrundbild",
                    "extensions": ".jpg,.jpeg,.png,.webp"
                },
                {
                    "type": "NumberSpinner",
                    "name": "TileDim",
                    "caption": "Bild abdunkeln",
                    "suffix": "%",
                    "minimum": 0,
                    "maximum": 90
                },
                {
                    "type": "NumberSpinner",
                    "name": "TileBlur",
                    "caption": "Bild weichzeichnen",
                    "suffix": "px",
                    "minimum": 0,
                    "maximum": 20
                },
                {
                    "type": "Label",
                    "caption": "Tipp: Querformat. Große Fotos werden automatisch auf 1600 Pixel verkleinert, damit die Kachel schnell lädt. Zum Entfernen das Bild im Feld löschen und übernehmen."
                },
                {
                    "type": "Label",
                    "caption": "Fahrzeugbild (statt des eingebauten Auto-Symbols)"
                },
                {
                    "type": "SelectFile",
                    "name": "CarImage",
                    "caption": "Bild des Fahrzeugs",
                    "extensions": ".png,.webp,.jpg,.jpeg"
                },
                {
                    "type": "CheckBox",
                    "name": "CarMirror",
                    "caption": "Bild spiegeln (Fahrzeug soll mit dem Ladeanschluss zur Wallbox zeigen)"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "CarPortX",
                            "caption": "Ladeanschluss von links",
                            "suffix": "%",
                            "minimum": 0,
                            "maximum": 100
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "CarPortY",
                            "caption": "Ladeanschluss von oben",
                            "suffix": "%",
                            "minimum": 0,
                            "maximum": 100
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Am besten ein freigestelltes PNG in Seitenansicht (transparenter Hintergrund; wird automatisch auf 800 Pixel verkleinert). Die Position des Ladeanschlusses bezieht sich auf das angezeigte (ggf. gespiegelte) Bild – nach dem Übernehmen sieht man das Ergebnis sofort in der Kachel."
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Jetzt aktualisieren",
                    "onClick": "echo EASEE_Update($id) ? 'Aktualisiert.' : 'Fehler - siehe Variable \"Letzter Fehler\".';"
                },
                {
                    "type": "Button",
                    "caption": "Verbindung testen / Charger anzeigen",
                    "onClick": "echo EASEE_ListChargers($id);"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Laden starten",
                    "onClick": "EASEE_StartCharging($id);"
                },
                {
                    "type": "Button",
                    "caption": "Laden pausieren",
                    "onClick": "EASEE_StopCharging($id);"
                },
                {
                    "type": "PopupButton",
                    "caption": "Ladehistorie löschen",
                    "popup": {
                        "caption": "Ladehistorie wirklich löschen?",
                        "items": [
                            {
                                "type": "Button",
                                "caption": "Ja, löschen",
                                "onClick": "EASEE_ResetHistory($id); echo 'Ladehistorie gelöscht.';"
                            }
                        ]
                    }
                },
                {
                    "type": "PopupButton",
                    "caption": "Statistik löschen",
                    "popup": {
                        "caption": "Monats- und Jahresstatistik wirklich löschen?",
                        "items": [
                            {
                                "type": "Button",
                                "caption": "Ja, löschen",
                                "onClick": "EASEE_ResetStatistics($id); echo 'Statistik gelöscht.';"
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Verbunden"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Instanz ist deaktiviert"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Bitte Benutzername und Passwort eintragen"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Anmeldung fehlgeschlagen - Zugangsdaten prüfen"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Easee API nicht erreichbar oder Fehler (siehe \"Letzter Fehler\")"
        }
    ]
}